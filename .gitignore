# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── Build output ────────────────────────────────────────────────────────────
dist/
build/
coverage/

# ─── Environment & secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example
.env*.local

# ─── OS junk ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Editor / IDE ─────────────────────────────────────────────────────────────
# Keep .vscode/settings.json (shared Tailwind config) – exclude user-specific files
.vscode/*.code-workspace
.vscode/launch.json
.vscode/tasks.json
.idea/
*.swp
*.swo

# ─── Deployment ──────────────────────────────────────────────────────────────
.vercel

# ─── Internal / temp design docs ─────────────────────────────────────────────
# PDF references used during development — not app code
*.pdf

# ─── AI tooling (local agent config) ─────────────────────────────────────────
.gemini/
.agents/
scratch/
